<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.agentsec.RiskEventMapper">

    <resultMap id="RiskEventResult" type="com.ruoyi.system.domain.agentsec.RiskEvent">
        <id property="eventId" column="event_id" />
        <result property="appId" column="app_id" />
        <result property="sessionId" column="session_id" />
        <result property="riskType" column="risk_type" />
        <result property="riskLevel" column="risk_level" />
        <result property="confidence" column="confidence" />
        <result property="status" column="status" />
        <result property="remark" column="remark" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <select id="selectRiskEventList" parameterType="com.ruoyi.system.domain.agentsec.RiskEvent" resultMap="RiskEventResult">
        select event_id, app_id, session_id, risk_type, risk_level, confidence, status, remark, create_by, create_time, update_by, update_time
        from agentsec_risk_event
        <where>
            <if test="appId != null and appId != ''">and app_id = #{appId}</if>
            <if test="sessionId != null and sessionId != ''">and session_id = #{sessionId}</if>
            <if test="riskType != null and riskType != ''">and risk_type = #{riskType}</if>
            <if test="riskLevel != null and riskLevel != ''">and risk_level = #{riskLevel}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectRiskEventById" parameterType="String" resultMap="RiskEventResult">
        select event_id, app_id, session_id, risk_type, risk_level, confidence, status, remark, create_by, create_time, update_by, update_time
        from agentsec_risk_event
        where event_id = #{eventId}
    </select>

    <update id="updateRiskEvent" parameterType="com.ruoyi.system.domain.agentsec.RiskEvent">
        update agentsec_risk_event
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="riskLevel != null and riskLevel != ''">risk_level = #{riskLevel},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where event_id = #{eventId}
    </update>

</mapper>
