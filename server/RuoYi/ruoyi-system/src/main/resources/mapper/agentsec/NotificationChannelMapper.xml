<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.agentsec.NotificationChannelMapper">

    <resultMap id="NotificationChannelResult" type="com.ruoyi.system.domain.agentsec.NotificationChannel">
        <id property="channelId" column="channel_id" />
        <result property="channelName" column="channel_name" />
        <result property="channelType" column="channel_type" />
        <result property="status" column="status" />
        <result property="remark" column="remark" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <select id="selectNotificationChannelList" parameterType="com.ruoyi.system.domain.agentsec.NotificationChannel" resultMap="NotificationChannelResult">
        select channel_id, channel_name, channel_type, status, remark, create_by, create_time, update_by, update_time
        from agentsec_notification_channel
        <where>
            <if test="channelName != null and channelName != ''">and channel_name like concat('%', #{channelName}, '%')</if>
            <if test="channelType != null and channelType != ''">and channel_type = #{channelType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

</mapper>
