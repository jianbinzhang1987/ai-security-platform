<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.agentsec.ApiKeyInfoMapper">

    <resultMap id="ApiKeyInfoResult" type="com.ruoyi.system.domain.agentsec.ApiKeyInfo">
        <id property="apiKeyId" column="api_key_id" />
        <result property="tenantId" column="tenant_id" />
        <result property="apiKeyName" column="api_key_name" />
        <result property="appId" column="app_id" />
        <result property="status" column="status" />
        <result property="expireTimeText" column="expire_time_text" />
        <result property="remark" column="remark" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <select id="selectApiKeyInfoList" parameterType="com.ruoyi.system.domain.agentsec.ApiKeyInfo" resultMap="ApiKeyInfoResult">
        select api_key_id, tenant_id, api_key_name, app_id, status,
               date_format(expire_time, '%Y-%m-%d %H:%i:%s') as expire_time_text,
               remark, create_by, create_time, update_by, update_time
        from agentsec_api_key
        <where>
            <if test="tenantId != null and tenantId != ''">and tenant_id = #{tenantId}</if>
            <if test="apiKeyName != null and apiKeyName != ''">and api_key_name like concat('%', #{apiKeyName}, '%')</if>
            <if test="appId != null and appId != ''">and app_id = #{appId}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

</mapper>
