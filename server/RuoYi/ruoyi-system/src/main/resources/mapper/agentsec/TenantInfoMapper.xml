<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.agentsec.TenantInfoMapper">

    <resultMap id="TenantInfoResult" type="com.ruoyi.system.domain.agentsec.TenantInfo">
        <id property="tenantId" column="tenant_id" />
        <result property="tenantName" column="tenant_name" />
        <result property="planCode" column="plan_code" />
        <result property="maxAgents" column="max_agents" />
        <result property="dataRetentionDays" column="data_retention_days" />
        <result property="status" column="status" />
        <result property="remark" column="remark" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <select id="selectTenantInfoList" parameterType="com.ruoyi.system.domain.agentsec.TenantInfo" resultMap="TenantInfoResult">
        select tenant_id, tenant_name, plan_code, max_agents, data_retention_days, status, remark, create_by, create_time, update_by, update_time
        from agentsec_tenant
        <where>
            <if test="tenantName != null and tenantName != ''">and tenant_name like concat('%', #{tenantName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

</mapper>
